{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 1 public JSON ledger and empty private template; not a validator of the owner-only Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visibility",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "visibility": {
      "enum": [
        "PUBLIC",
        "PRIVATE"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "classification",
          "domains",
          "publication_status",
          "publication_evidence",
          "original_location",
          "original_copy_relationship",
          "document_version",
          "document_revised_at",
          "service_revision",
          "service_updated_at",
          "body_check_status",
          "body_evidence",
          "body_sha256",
          "approval_history_status",
          "approval_evidence",
          "effective_from",
          "effective_until",
          "application_state",
          "application_evidence",
          "duplicate_candidates",
          "conflict_candidates",
          "unknowns",
          "last_verified_at",
          "verification_method"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^(PUB|SRC)-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "CONSTITUTION",
              "FORMAL_RULE",
              "OPERATING_GUIDE",
              "RESEARCH_RESULT",
              "DRAFT_HYPOTHESIS",
              "RESEARCH_PLAN",
              "DICTIONARY",
              "SOURCE_TEXT",
              "UNKNOWN"
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "enum": [
                "EDOBEN",
                "PHILOSOPHY",
                "BEHAVIOR",
                "CONSTITUTION",
                "RULES_OPERATIONS"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "publication_status": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "UNKNOWN"
            ]
          },
          "publication_evidence": {
            "type": "string",
            "minLength": 1
          },
          "original_location": {
            "type": "string",
            "minLength": 1
          },
          "original_copy_relationship": {
            "type": "string",
            "minLength": 1
          },
          "document_version": {
            "type": "string",
            "minLength": 1
          },
          "document_revised_at": {
            "type": "string",
            "minLength": 1
          },
          "service_revision": {
            "type": "string",
            "minLength": 1
          },
          "service_updated_at": {
            "type": "string",
            "minLength": 1
          },
          "body_check_status": {
            "enum": [
              "VERIFIED_BODY",
              "PARTIAL_BODY",
              "SEARCH_ONLY",
              "NOT_TESTED"
            ]
          },
          "body_evidence": {
            "type": "string",
            "minLength": 1
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64}|UNKNOWN|NOT_TESTED)$"
          },
          "approval_history_status": {
            "enum": [
              "VERIFIED",
              "PARTIAL",
              "NOT_TESTED"
            ]
          },
          "approval_evidence": {
            "type": "string",
            "minLength": 1
          },
          "effective_from": {
            "type": "string",
            "minLength": 1
          },
          "effective_until": {
            "type": "string",
            "minLength": 1
          },
          "application_state": {
            "enum": [
              "CURRENT",
              "DRAFT",
              "SUPERSEDED",
              "ARCHIVED",
              "CONFLICT",
              "NOT_A_RULE",
              "UNKNOWN"
            ]
          },
          "application_evidence": {
            "type": "string",
            "minLength": 1
          },
          "duplicate_candidates": {
            "type": "string",
            "minLength": 1
          },
          "conflict_candidates": {
            "type": "string",
            "minLength": 1
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "last_verified_at": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "application_state": {
                  "const": "CURRENT"
                }
              }
            },
            "then": {
              "properties": {
                "approval_history_status": {
                  "const": "VERIFIED"
                },
                "approval_evidence": {
                  "not": {
                    "enum": [
                      "UNKNOWN",
                      "NOT_TESTED"
                    ]
                  }
                },
                "effective_from": {
                  "not": {
                    "enum": [
                      "UNKNOWN",
                      "NOT_TESTED"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
